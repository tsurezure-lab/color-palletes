        // --- JavaScript ロジック ---

        /**
         * 単一のカラーパレットのHTMLカードを生成します。
         * @param {object} palette - パレットオブジェクト ({name, colors})
         * @param {string} source - データソース (Tableau or Power BI)
         * @returns {string} - パレットカードのHTML文字列
         */
        function createPaletteHtml(palette, source) {
            const colorChips = palette.colors.map(color => {
                // 白や非常に薄い色の場合は境界線を追加
                const borderColor = (color.toUpperCase() === '#FFFFFF' || color.toUpperCase() === '#F7F7F7' || color.toUpperCase() === '#F5F5F5' || color.toUpperCase() === '#FFF7BC') ? 'border border-gray-200' : '';
                return `<div class="color-chip ${borderColor}" style="background-color: ${color};"></div>`;
            }).join('');

            // クリックイベントで selectPalette 関数を呼び出す
            const colorListString = JSON.stringify(palette.colors).replace(/"/g, "'");
            const selectFunctionCall = `selectPalette('${palette.name}', ${colorListString}, '${source}')`;
            
            return `
                <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition duration-300 ease-in-out overflow-hidden cursor-pointer" onclick="${selectFunctionCall}">
                    <div class="p-4">
                        <h4 class="text-base font-semibold text-gray-800 mb-2">${palette.name}</h4>
                        <p class="text-xs text-gray-500 font-medium">${source}</p>
                    </div>
                    <div class="flex h-10 w-full overflow-hidden">
                        ${colorChips}
                    </div>
                </div>
            `;
        }

        /**
         * 全てのパレットデータを取得し、メインコンテナに表示します。
         */
        function renderPalettes() {
            const container = document.getElementById('palette-main-container');
            let allHtml = '';

            // Tableau パレットのレンダリング
            allHtml += renderPaletteSource(tableauDefaultPalettes, 'Tableau');
            
            // Power BI パレットのレンダリング
            allHtml += renderPaletteSource(powerBiPalettes, 'Power BI');

            container.innerHTML = allHtml;
        }

        /**
         * 特定のデータソースのパレット群をレンダリングします。
         * @param {Array<object>} sourceData - データソースのパレット群
         * @param {string} sourceName - データソース名
         * @returns {string} - HTML文字列
         */
        function renderPaletteSource(sourceData, sourceName) {
            let sourceHtml = `
                <section>
                    <h2 class="text-2xl font-bold border-b-2 border-blue-500 pb-2 mb-6 text-blue-700">${sourceName} パレット</h2>
            `;
            
            sourceData.forEach(group => {
                const groupTitle = group.type;
                const paletteCards = group.palettes
                    .map(palette => createPaletteHtml(palette, sourceName))
                    .join('');

                sourceHtml += `
                    <div class="mb-8">
                        <h3 class="text-xl font-semibold text-gray-700 mb-4">${groupTitle}</h3>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                            ${paletteCards}
                        </div>
                    </div>
                `;
            });

            sourceHtml += `</section>`;
            return sourceHtml;
        }


        /**
         * パレットを選択したとき、固定ヘッダーに詳細を表示します。
         * @param {string} name - パレット名
         * @param {Array<string>} colors - HEXコードの配列
         * @param {string} source - データソース
         */
        function selectPalette(name, colors, source) {
            const container = document.getElementById('selected-palette-container');
            const nameEl = document.getElementById('selected-name');
            const colorsEl = document.getElementById('selected-colors');
            const hexCodesEl = document.getElementById('selected-hex-codes');

            // 1. 名前とソースの更新
            nameEl.textContent = `${name} (${source})`;

            // 2. カラーチップの更新
            const colorChipsHtml = colors.map(color => {
                const borderColor = (color.toUpperCase() === '#FFFFFF' || color.toUpperCase() === '#F7F7F7' || color.toUpperCase() === '#F5F5F5' || color.toUpperCase() === '#FFF7BC') ? 'border border-gray-200' : '';
                // 各カラーチップに色名をツールチップとして表示 (モバイルでは非表示)
                const tooltipText = `<span class="hidden sm:block absolute bottom-full left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">${color}</span>`;
                return `
                    <div class="color-chip relative group ${borderColor}" 
                         style="background-color: ${color};" 
                         title="${color}">
                         ${tooltipText}
                    </div>
                `;
            }).join('');
            colorsEl.innerHTML = colorChipsHtml;

            // 3. HEXコードの更新
            const hexCodesString = colors.join(', ');
            hexCodesEl.value = hexCodesString;
            hexCodesEl.rows = Math.ceil(hexCodesString.length / 50) + 1; // テキスト量に応じて行数を自動調整

            // 4. 固定ヘッダーの表示
            container.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' }); // 画面上部にスクロール
            
            // 5. コピーボタンのテキストをリセット
            const copyButton = document.getElementById('copy-button');
            copyButton.textContent = 'HEXコードをコピー';
            copyButton.classList.remove('bg-green-600', 'hover:bg-green-700');
            copyButton.classList.add('bg-blue-600', 'hover:bg-blue-700');
        }

        /**
         * 選択されたパレットの詳細表示を閉じます。
         */
        function closeSelected() {
            document.getElementById('selected-palette-container').classList.add('hidden');
        }

        /**
         * HEXコードをクリップボードにコピーします。
         */
        function copyToClipboard() {
            const textarea = document.getElementById('selected-hex-codes');
            const button = document.getElementById('copy-button');

            try {
                // テキストエリアを選択し、コピーを実行
                textarea.select();
                document.execCommand('copy');
                
                // コピー成功時のフィードバック
                button.textContent = 'コピーしました!';
                button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                button.classList.add('bg-green-600', 'hover:bg-green-700');

                // 2秒後にボタンのテキストを元に戻す
                setTimeout(() => {
                    button.textContent = 'HEXコードをコピー';
                    button.classList.remove('bg-green-600', 'hover:bg-green-700');
                    button.classList.add('bg-blue-600', 'hover:bg-blue-700');
                }, 2000);

            } catch (err) {
                // エラー時のメッセージ表示 (開発環境向け)
                console.error('クリップボードへのコピーに失敗しました:', err);
                button.textContent = 'コピー失敗 (コンソールを確認)';
                button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
                button.classList.add('bg-red-600', 'hover:bg-red-700');
            }
        }

        // --- 初期化 ---
        window.onload = renderPalettes;
